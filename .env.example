# Supabase — safe for the browser (dashboard's client-side Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Also serves as the HMAC secret for verifying X-Retell-Signature on incoming
# webhook/function calls — RetellAI signs with the API key itself, no
# separate webhook secret to configure.
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/booking-async

# Legacy — used by the current src/lib/api.ts until Phase 5 replaces its direct
# n8n calls with the Supabase-backed booking-core. Remove once that lands.
NEXT_PUBLIC_N8N_BASE_URL=https://your-n8n-instance.example.com
NEXT_PUBLIC_INTAKE_WEBHOOK_PATH=/webhook/dental-lead
NEXT_PUBLIC_CHAT_WEBHOOK_ID=your-chat-webhook-id

# Supabase — safe for the browser (dashboard's client-side Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
ANTHROPIC_API_KEY=your-anthropic-api-key
RETELL_API_KEY=your-retell-api-key
RETELL_WEBHOOK_SECRET=your-retell-webhook-shared-secret
RETELL_AGENT_ID=your-retell-agent-id
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/booking-async
